# fuelrod-backup example config
# Copy this file to .backup and customize values.
#
# Two config styles are supported:
#
#   Single-engine  — set DB_TYPE + generic DB_* keys (original behaviour)
#   Multi-engine   — set engine-prefixed PG_* / MY_* / MS_* keys and run
#                    `fuelrod-backup backup --all-engines` to back up all
#                    configured engines in parallel.
#
# In multi-engine mode DB_TYPE / DB_* keys are ignored.
# Shared settings (BASE_DIR, COMPRESS_FILE, KEEP_DAYS, CONNECTION_TIMEOUT)
# are always read without a prefix.

# ── Shared ──────────────────────────────────────────────────────────────────
BASE_DIR=./db-backup
COMPRESS_FILE=true
KEEP_DAYS=7
CONNECTION_TIMEOUT=30

# ══════════════════════════════════════════════════════════════════════════════
# SINGLE-ENGINE MODE  (comment out to use multi-engine mode below)
# ══════════════════════════════════════════════════════════════════════════════

# Engine: postgres | mariadb | mssql
DB_TYPE=postgres

# Connection
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=5432

# Docker mode
USE_DOCKER=true
SERVICE=postgres

# PostgreSQL commands
PG_DUMP_CMD=pg_dump
PG_RESTORE_CMD=pg_restore

# MariaDB commands
MYSQL_DUMP_CMD=mariadb-dump
MYSQL_CMD=mysql

# MSSQL backup location inside container
MSSQL_BACKUP_DIR=/var/opt/mssql/backups

# ══════════════════════════════════════════════════════════════════════════════
# MULTI-ENGINE MODE  (run: fuelrod-backup backup --all-engines)
# Only engines with credentials set are activated.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL (PG_) ─────────────────────────────────────────────────────────
#PG_USERNAME=postgres
#PG_PASSWORD=change_me
#PG_HOST=127.0.0.1
#PG_PORT=5432
#PG_SERVICE=postgres
#PG_USE_DOCKER=true
#PG_DUMP_CMD=pg_dump
#PG_RESTORE_CMD=pg_restore
#PG_CMD=psql

# ── MariaDB / MySQL (MY_) ────────────────────────────────────────────────────
#MY_USERNAME=root
#MY_PASSWORD=change_me
#MY_HOST=127.0.0.1
#MY_PORT=3306
#MY_SERVICE=mariadb
#MY_USE_DOCKER=true
#MY_DUMP_CMD=mariadb-dump
#MY_CMD=mysql

# ── MSSQL (MS_) ──────────────────────────────────────────────────────────────
#MS_USERNAME=sa
#MS_PASSWORD=change_me
#MS_HOST=127.0.0.1
#MS_PORT=1433
#MS_SERVICE=mssql
#MS_USE_DOCKER=true
#MS_BACKUP_DIR=/var/opt/mssql/backups

# ── Operations ──────────────────────────────────────────────
# GFS retention profile (overrides KEEP_DAYS): newest backup of each of the last N periods
# RETENTION=daily=7,weekly=4,monthly=12
# Lifecycle hooks: PRE_BACKUP_HOOK aborts the backup on non-zero exit; POST_BACKUP_HOOK only warns
# PRE_BACKUP_HOOK=
# POST_BACKUP_HOOK=
# Keep BASE_DIR/manifest.json (a global index of all backups, read by pull instead of listing folders)
# MANIFEST=true
# Warn when a dump is smaller than this fraction of the previous one (0 = off)
# SIZE_WARN_RATIO=0.5

# ── Pull / push: rclone remotes you already configured (rclone config) ──
# `fuelrod-backup pull` downloads from PULL_REMOTE; `push` / `sync` uploads to PUSH_REMOTE
# Point PULL_REMOTE at the folder that holds the postgres/ mariadb/ mssql/ folders
# PULL_REMOTE=akilimo-bkp:db-backup
# Files pull never downloads (globs, separated by |); matches the name, the path or engine/database/file
# PULL_EXCLUDE=*_inc.*|manifest_*.txt|postgres/sonar/*
# Delete the files on the server after they are verified in the local folder (pull --delete-remote needs --yes)
# PULL_DELETE_REMOTE=false
# PULL_KEEP_REMOTE=1     # newest backups per database to leave on the server
# PUSH_REMOTE=offsite:incoming
# Several destinations, separated by |  (rclone remotes and/or local folders such as a OneDrive folder):
# PUSH_REMOTE=akilimo-bkp:backups|D:/OneDrive/Backups
# Newest backups per database that push/sync uploads (0 = all files)
# PUSH_LATEST=3
# Delete local files after a successful push? Set false if you also pull into this folder
# PUSH_DELETE_LOCAL=true
# Remote size limit: push/sync prunes the oldest remote backups to fit it; `fuelrod-backup quota` reports usage
# PUSH_QUOTA=50G
# PUSH_QUOTA_TARGET=90   # prune down to this percent of the quota
# PUSH_QUOTA_KEEP=1      # newest backups per database that are never pruned

# rclone executable when it is not on PATH
# RCLONE_CMD=D:/tools/rclone.exe

# ── Incremental backups (PostgreSQL) ────────────────────────
# INCREMENTAL=false
# INCREMENTAL_KEEP=5

# ── Encryption at rest ──────────────────────────────────────
# ENCRYPT=false
# ENCRYPT_TOOL=age                 # age | gpg
# ENCRYPT_RECIPIENT=
# ENCRYPT_IDENTITY_FILE=           # private key used to decrypt (age identity)
# ENCRYPT_PASSPHRASE_FILE=         # passphrase file (gpg symmetric)

# ── Notifications ───────────────────────────────────────────
# NOTIFY_ON=failure                # success | failure | all
# NOTIFY_URL=https://hooks.example.com/fuelrod
# NOTIFY_TIMEOUT=15
# NOTIFY_HOOK_SUCCESS=
# NOTIFY_HOOK_FAILURE=

# ── Off-site sync: S3 and generic remote (set with `fuelrod-backup sync-init`) ──
# S3_REMOTE=s3-backup
# S3_BUCKET=
# S3_PREFIX=
# S3_PROVIDER=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── n8n volume backup ───────────────────────────────────────
# N8N_SERVICES=n8n                 # space separated
# SKIP_SERVICES=

# ── Tools ───────────────────────────────────────────────────
# PSQL_CMD=psql
